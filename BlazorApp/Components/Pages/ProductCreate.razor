@page "/products/create"
@rendermode InteractiveServer
@using BlazorApp.UnitOfWork
@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Create Product</PageTitle>

<div class="product-page">
    <div class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/products">Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h1 class="page-title">Create Product</h1>
            <p class="page-subtitle">Add a new item to your catalog</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="card product-card shadow-sm">
        <div class="card-body p-4">
            <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="productName">Product Name</label>
                    <InputText id="productName" class="form-control form-control-lg" @bind-Value="model.Name" placeholder="Enter product name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" for="productPrice">Price (₹)</label>
                    <InputNumber id="productPrice" class="form-control form-control-lg" @bind-Value="model.Price" placeholder="0.00" />
                    <ValidationMessage For="@(() => model.Price)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Create Product</span>
                        }
                    </button>
                    <a class="btn btn-outline-secondary btn-lg" href="/products">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ProductCreateModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleValidSubmit()
    {
        if (model.Price is null)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        var (created, error) = await ProductService.CreateAsync(model);

        if (created != null)
        {
            Navigation.NavigateTo("/products");
            return;
        }

        errorMessage = error;
        isSubmitting = false;
    }
}
