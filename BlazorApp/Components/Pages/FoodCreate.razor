@page "/foods/create"
@rendermode InteractiveServer
@using BlazorApp.UnitOfWork
@inject FoodClientService FoodService
@inject NavigationManager Navigation

<PageTitle>Create Food</PageTitle>

<div class="product-page">
    <div class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/foods">Foods</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <h1 class="page-title">Create Food</h1>
            <p class="page-subtitle">Add a new food item to the list</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="card product-card shadow-sm">
        <div class="card-body p-4">
            <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="form-label fw-semibold" for="foodName">Food Name</label>
                    <InputText id="foodName" class="form-control form-control-lg" @bind-Value="model.Name" placeholder="Enter food name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Food</span>
                        }
                    </button>
                    <a class="btn btn-outline-secondary btn-lg" href="/foods">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private FoodCreateModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var (created, error) = await FoodService.CreateAsync(model);
        if (created != null)
        {
            Navigation.NavigateTo("/foods");
            return;
        }

        errorMessage = error;
        isSubmitting = false;
    }
}
