@page "/messages"
@rendermode InteractiveServer
@using BlazorApp.UnitOfWork
@inject MessageClientService MessageService

<PageTitle>Messages</PageTitle>

<div class="product-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Messages</h1>
            <p class="page-subtitle">Create and view stored messages</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-secondary" @onclick="LoadMessagesAsync" disabled="@isLoading">
                Refresh
            </button>
            <a class="btn btn-primary" href="/messages/create">+ Add Message</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <span>@errorMessage</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="LoadMessagesAsync">Retry</button>
        </div>
    }

    <div class="card product-card shadow-sm">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 mb-0 text-muted">Loading messages...</p>
                </div>
            }
            else if (messages is null || messages.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">💬</div>
                    <h5>No messages yet</h5>
                    <p class="text-muted">Create your first message to store it in the database.</p>
                    <a class="btn btn-primary" href="/messages/create">Create Message</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover product-table mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Message Content</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in messages)
                            {
                                <tr>
                                    <td class="text-muted">@message.Id</td>
                                    <td>@message.Content</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted small">@messages.Count message@(messages.Count == 1 ? "" : "s") found</span>
                    <a class="btn btn-sm btn-primary" href="/messages/create">Add another</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<MessageDto>? messages;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadMessagesAsync();
    }

    private async Task LoadMessagesAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        var (items, error) = await MessageService.GetAllAsync();
        messages = items;
        errorMessage = error;
        isLoading = false;
    }
}
