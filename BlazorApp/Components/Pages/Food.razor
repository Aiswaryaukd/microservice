@page "/foods"
@rendermode InteractiveServer
@using BlazorApp.UnitOfWork
@inject FoodClientService FoodService

<PageTitle>Foods</PageTitle>

<div class="product-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Foods</h1>
            <p class="page-subtitle">Manage your food list</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-secondary" @onclick="LoadFoodsAsync" disabled="@isLoading">
                Refresh
            </button>
            <a class="btn btn-primary" href="/foods/create">+ Add Food</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <span>@errorMessage</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="LoadFoodsAsync">Retry</button>
        </div>
    }

    <div class="card product-card shadow-sm">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 mb-0 text-muted">Loading foods...</p>
                </div>
            }
            else if (foods is null || foods.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">🍽️</div>
                    <h5>No foods yet</h5>
                    <p class="text-muted">Create your first food item to get started.</p>
                    <a class="btn btn-primary" href="/foods/create">Create Food</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover product-table mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Food Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var food in foods)
                            {
                                <tr>
                                    <td class="text-muted">@food.Id</td>
                                    <td class="fw-semibold">@food.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted small">@foods.Count food@(foods.Count == 1 ? "" : "s") found</span>
                    <a class="btn btn-sm btn-primary" href="/foods/create">Add another</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FoodDto>? foods;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadFoodsAsync();
    }

    private async Task LoadFoodsAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        var (items, error) = await FoodService.GetAllAsync();
        foods = items;
        errorMessage = error;
        isLoading = false;
    }
}
